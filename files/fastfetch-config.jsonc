{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    // ============================================================
    // LOGO
    // ============================================================

    "logo": {
        "type": "small",
        "padding": {
            "right": 3
        }
    },


    // ============================================================
    // DISPLAY
    // ============================================================

    "display": {
        "separator": "  ",

        "key": {
            "width": 11,
            "type": "string"
        },

        "color": {
            "keys": "blue",
            "output": "white",
            "title": "cyan"
        }
    },


    // ============================================================
    // MODULES
    // ============================================================

    "modules": [

        // --------------------------------------------------------
        // USER
        // --------------------------------------------------------

        {
            "type": "title",
            "format": "User: {user-name}@{host-name}"
        },

        "separator",


        // --------------------------------------------------------
        // SYSTEM INFORMATION
        // --------------------------------------------------------

        {
            "type": "custom",
            "format": "System Information",
            "outputColor": "cyan"
        },

        {
            "type": "os",
            "key": "OS",
            "format": "{name} {arch}"
        },

        {
            "type": "kernel",
            "key": "Kernel",
            "format": "{sysname} {release}"
        },

        {
            "type": "uptime",
            "key": "Uptime"
        },

        {
            "type": "packages",
            "key": "Packages"
        },


        "break",


        // --------------------------------------------------------
        // DESKTOP ENVIRONMENT
        // --------------------------------------------------------

        {
            "type": "custom",
            "format": "Desktop Environment",
            "outputColor": "cyan"
        },

        {
            "type": "de",
            "key": "DE"
        },

        {
            "type": "wm",
            "key": "WM",
            "format": "{pretty-name} ({protocol-name})"
        },

        {
            "type": "shell",
            "key": "Shell",
            "format": "{pretty-name}"
        },

        {
            "type": "terminal",
            "key": "Terminal",
            "format": "{pretty-name}"
        },


        "break",


        // --------------------------------------------------------
        // HARDWARE INFORMATION
        // --------------------------------------------------------

        {
            "type": "custom",
            "format": "Hardware Information",
            "outputColor": "cyan"
        },

        {
            "type": "cpu",
            "key": "CPU",
            "format": "{name} ({cores-physical}+{cores-logical}) @ {freq-max}"
        },

        {
            "type": "gpu",
            "key": "GPU",
            "hideType": "integrated",
            "format": "{name}"
        },

        {
            "type": "gpu",
            "key": "GPU Driver",
            "hideType": "integrated",
            "format": " {driver} "
        },

        {
            "type": "memory",
            "key": "Memory"
        },

        {
            "type": "disk",
            "key": "Disk",
            "folders": [
                "/"
            ]
        }

    ]
}

